@page "{id:int}"
@model GamersWorld.RazorApp.Pages.Games.DeleteModel
@{
    ViewData["Title"] = "Delete Game";
    string StatusLabel(short s) => s switch { 0 => "On Sale", 1 => "Out of Sale", 2 => "Pre-Sale", _ => "Unknown" };
    string StatusBadge(short s) => s == 0 ? "bg-success" : s == 1 ? "bg-danger" : "bg-warning text-dark";
}

<h1>Delete Game</h1>
<hr />

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (Model.Game is not null)
{
    <div class="alert alert-warning">
        <strong>Are you sure you want to delete this game?</strong> This action cannot be undone.
    </div>

    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Model.Game.Id</dd>

        <dt class="col-sm-2">Title</dt>
        <dd class="col-sm-10">@Model.Game.Title</dd>

        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">
            <span class="badge @StatusBadge(Model.Game.Status)">@StatusLabel(Model.Game.Status)</span>
        </dd>

        <dt class="col-sm-2">Point</dt>
        <dd class="col-sm-10">@Model.Game.Point.ToString("F1")</dd>

        <dt class="col-sm-2">List Price</dt>
        <dd class="col-sm-10">@Model.Game.ListPrice.ToString("C")</dd>
    </dl>

    <form method="post" asp-route-id="@Model.Game.Id">
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-page="./Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
}
